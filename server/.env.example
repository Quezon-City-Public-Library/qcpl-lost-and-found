# QCPL Lost & Found — server settings
# 1. Copy this file and name the copy  .env  (keep it in this "server" folder)
# 2. Fill in only the parts you want to turn on. Leave the rest empty.
# 3. Keep .env private. Never share it or upload it. It holds passwords and keys.
# 4. After saving, double-click "Test email and text.bat" to check that everything works.
#    Easier: double-click "Set up email and text messages.bat" - it asks the questions and fills this in for you.
#
# Type each value right after the = sign, with no spaces and no quotes.

# ---- Email updates -------------------------------------------------------
# Works with any email service that allows "SMTP" sending. Two common choices:
#
# A) Brevo (brevo.com) — free, about 300 emails a day, no Google settings needed
#      SMTP_HOST=smtp-relay.brevo.com
#      SMTP_PORT=587
#      SMTP_USER=the "Login" shown on Brevo's page  SMTP & API > SMTP
#      SMTP_PASS=the "SMTP key" you create on that same page
#      MAIL_FROM=QCPL Lost & Found <the email address you verified as a sender in Brevo>
#
# B) A Gmail account that has 2-Step Verification turned on
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=465
#      SMTP_USER=your full Gmail address
#      SMTP_PASS=a 16-letter "App password" (myaccount.google.com/apppasswords).
#                Your normal Gmail password will NOT work here.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Name and address shown as the sender (optional for Gmail, needed for Brevo)
MAIL_FROM=

# ---- Text (SMS) updates — Semaphore (semaphore.co), Philippine numbers -----
# The API key is on your Semaphore dashboard. Each text uses credits.
SEMAPHORE_API_KEY=
# Sender name approved on your Semaphore account (optional)
SEMAPHORE_SENDER=

# ---- Online photo reading — Claude ----------------------------------------
# An API key from console.anthropic.com (starts with sk-ant-).
ANTHROPIC_API_KEY=

# ---- Where the test sends its messages ------------------------------------
# Used only by "Test email and text.bat". Put your own email and mobile number.
TEST_EMAIL=
# A Philippine mobile number, e.g. 09171234567. Leave empty to check the SMS key without sending a text.
TEST_PHONE=

# ---- Going online (leave empty while testing on this computer) ----
# The public address of the site, e.g. https://lostandfound.qcpl.gov.ph  (also turns on HSTS for https,
# and is used for the "Check your report" link inside emails)
SITE_URL=
# Other addresses the server may answer to, comma-separated (e.g. www.example.ph:443)
ALLOWED_HOSTS=
# Which network address to listen on. 127.0.0.1 = this computer only (safest). Use 0.0.0.0 only behind a proxy.
HOST=127.0.0.1
# Set to 1 when the server runs behind Nginx, Caddy, IIS or Cloudflare, so each visitor is counted separately
#   TRUST_PROXY=cloudflare  with Cloudflare Tunnel on this computer
#   TRUST_PROXY=1           with one other proxy (Nginx, IIS, Render...)
TRUST_PROXY=

# ---- Daily limits for the whole site (protect your SMS credits and AI budget) ----
SMS_DAILY_LIMIT=300
EMAIL_DAILY_LIMIT=1000
PHOTO_DAILY_LIMIT=300
# ---- Database and backups ----
# Folder for the database (qcpl.db). Leave empty to use server/data — or, when this project is inside
# OneDrive/Dropbox, a local folder (%LOCALAPPDATA%\QCPL Lost and Found\data). Never put it in a synced folder.
DATA_DIR=
# Folder for the daily backups (default: DATA_DIR\backups) and how many to keep
BACKUP_DIR=
BACKUP_KEEP=14
# 1 = show sign-up and reset codes on screen (only for trying the site with no email/SMS). Never on a real website.
DEMO_CODES=

# A second folder that gets a copy of every encrypted backup (another drive, a USB drive or a network share)
# Empty = the OneDrive folder ("QCPL Lost and Found backups"), if OneDrive is set up. "off" = no second copy.
# Only encrypted backups are copied. The copy folder keeps the newest BACKUP_COPY_KEEP (default 60).
BACKUP_COPY_DIR=
# Largest backup file that can be uploaded on the Backups page (in MB)
MAX_RESTORE_UPLOAD_MB=2048

# ---------------------------------------------------------------------------
# ADMINISTRATOR SIGN-IN: where staff may sign in from (the page is /admin).
#   empty     anywhere (the page is just not linked from the public site)
#   local     only this computer and the library's own network (192.168.x.x, 10.x.x.x, 172.16-31.x.x)
#   a list    addresses or starts of addresses, e.g.  local, 203.177.42.10, 112.198.
# When the site is online behind a proxy, also set TRUST_PROXY (cloudflare or 1, see above) so the real address is seen.
ADMIN_NETWORKS=
